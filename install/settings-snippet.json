{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/inject-rules.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/inject-rules.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/deploy-gate.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/db-write-guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/walk-brief-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/read-ledger-gate.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/no-idle.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/double-check.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/measure-gate.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/citation-gate.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/sprint-gate.mjs\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"<HOOK_KIT_DIR>/hooks/wake.mjs\"",
            "timeout": 1800,
            "asyncRewake": true
          }
        ]
      }
    ]
  }
}
